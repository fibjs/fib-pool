{
    "compilerOptions": {
        // `fibjs --check` derives its default lib from the target: with es6
        // that is lib.dom, which collides with the fibjs built-in types.
        // es2020 is the lowest target whose default lib stays es-only.
        "target": "es2020",
        "module": "commonjs",
        "noEmit": true
    },
    "exclude": [
        "node_modules"
    ]
}
